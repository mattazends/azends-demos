{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/extensions", "destination": "/index.html" },
    { "source": "/extensions/", "destination": "/index.html" },
    { "source": "/new-builds", "destination": "/index.html" },
    { "source": "/new-builds/", "destination": "/index.html" },
    { "source": "/contact-us", "destination": "/index.html" },
    { "source": "/contact-us/", "destination": "/index.html" },
    { "source": "/about-us", "destination": "/index.html" },
    { "source": "/about-us/", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/free-guide/:path*", "destination": "/", "permanent": true },
    { "source": "/renovations/:path*", "destination": "/", "permanent": true },
    { "source": "/structural-alterations/:path*", "destination": "/", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy-policy", "permanent": true },
    { "source": "/wp-content/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
